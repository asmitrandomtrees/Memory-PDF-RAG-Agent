# ============================================================
# Application
# ============================================================

APP_ENV=development
APP_NAME=conversational-memory-agent
LOG_LEVEL=INFO

# ============================================================
# Azure OpenAI
# ============================================================

OPENAI_API_KEY=
OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=
OPENAI_ENDPOINT=
# Per-request timeout and SDK retries for chat calls.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ============================================================
# Embeddings
# ============================================================

EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=BAAI/bge-m3

# ============================================================
# Vector Store
# ============================================================

VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./vectorstore

STM_COLLECTION=stm_collection
LTM_COLLECTION=ltm_collection
PDF_COLLECTION=pdf_collection
PDF_UPLOAD_PATH=./data/uploads/pdfs
MAX_PDF_UPLOAD_BYTES=26214400

# ============================================================
# Conversation Storage
# ============================================================

CONVERSATION_STORE_TYPE=jsonl
CONVERSATION_DATA_PATH=./data/conversations/dev

# ============================================================
# Retrieval
# ============================================================

STM_TOP_K=5
LTM_TOP_K=5
PDF_TOP_K=5

# ============================================================
# Agent
# ============================================================

# Each answer retry re-runs routing, retrieval, answering and validation.
MAX_RETRIES=2
MAX_CONTEXT_TOKENS=6000
# ============================================================
# Fine-tuning
# ============================================================

# Base model to fine-tune (must support fine-tuning in your Azure region).
FINETUNE_BASE_MODEL=gpt-4o-mini-2024-07-18
FINETUNE_API_VERSION=2024-10-21
FINETUNE_DATA_PATH=./data/finetuning
